{
    "name": "sonar",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "VITE_GIT_VERSION=$(git describe  --tags --long) vite build",
        "preview": "vite preview",
        "lint": "biome check src && tsc --noEmit",
        "format": "biome format --write src",
        "test": "vitest --run",
        "checkall": "pnpm test && pnpm lint && pnpm build"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "happy-dom": "^20.9.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "dependencies": {},
    "packageManager": "pnpm@12.10.1"
}
